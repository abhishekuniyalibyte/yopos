# Copy to .env and fill in. Never commit .env.

# Required. Stays on the server; the widget never sees it.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Groq serves open-weight models over an OpenAI-compatible API. Which models a key can
# reach varies by account — list yours with:
#   curl -H "authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# On the free tier each model has its OWN tokens-per-day budget (200k), so if one is
# exhausted, switch models here rather than waiting.
# Alternatives: openai/gpt-oss-120b (strongest), qwen/qwen3.8-27b
MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

MAX_TOKENS=1024

# Low by design: this assistant looks things up and fills in ids, it does not write prose.
TEMPERATURE=0.3

# Browser origins allowed to call this API. Set to the YOPOS site origin before
# deploying — "*" is a development default only.
ALLOWED_ORIGINS=*

# Messages per session per minute.
RATE_LIMIT_PER_MINUTE=20

SESSION_TTL_SECONDS=3600
MAX_TOOL_HOPS=8
MAX_HISTORY_MESSAGES=40

# Leave false. The menu has no calorie, protein or ingredient data, so with this on every
# nutrition figure the assistant gives is inferred from an item's name — i.e. fabricated.
ALLOW_NUTRITION_INFERENCE=false
